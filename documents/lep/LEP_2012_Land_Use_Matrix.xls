<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Page not found</title>
	<style type="text/css">
		html { font-size: 10px; }
		body { text-align: center; font-family: Helvetica, sans-serif; font-size: 1.8rem; color: #444; }
		article { text-align: left; width: 80%; margin: 50px auto 0; }
		h1 { font-size: 3.5rem; }
		p { line-height: 1.5; }
		#countdown { font-size: 2.5rem; }
		img { width: 125px; display: block; margin-left: -19px; }

		@media (min-width: 768px) {
			body { font-size: 1.8rem; }
			article { margin-top: 100px; width: 65%; }
			h1 { font-size: 4.6rem; }
			#countdown { font-size: 3rem; }
			img { width: 175px; margin-left: -27px; }
		}
		@media (min-width: 992px) {
			body { font-size: 2rem; }
			article { margin-top: 150px; width: 55%; }
			img { width: 200px; margin-left: -31px; }
		}
	</style>
</head>
<body>
	<article>
        <img src="data:image/png;base64," alt="Document with a sad face">
		<h1>We couldn’t find the page you’re looking for</h1>
        <p>Please check the address and try again.</p>
	</article>
</body>
</html>