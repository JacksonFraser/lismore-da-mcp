.venv/
__pycache__/
*.pyc
.DS_Store

# Claude Code config is shared, except the per-machine permission file.
# .claude/settings.json, commands/, agents/ and hooks/ are committed on purpose —
# the document-safety hook below is only useful if everyone gets it.
.claude/settings.local.json

# Generated SEE PDFs contain applicant PII — never commit them.
documents/output/*
!documents/output/.gitkeep

# Third party's real signed document, kept out on purpose — see _quarantined/README.md.
_quarantined/

# The repo owner's own real business/address details.
my-application/

# Built at deploy time from documents/; rebuilt automatically if absent.
.search-index.sqlite3
*.sqlite3.building
